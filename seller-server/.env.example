# Copy to .env (or export these directly) before running `cargo run`.
# Once Role A has deployed the program and set up the mint/keypairs
# (architecture doc, Section 3.1), these all come from that step's output —
# `deployment.json` in the repo root is where the doc suggests keeping them.

# The Solana validator's JSON-RPC endpoint. Defaults shown are for a local
# `solana-test-validator`.
RPC_HOST=127.0.0.1
RPC_PORT=8899

# Required — no defaults, since these identify a specific deployed program
# and specific accounts. The server will refuse to start without them.
PROGRAM_ID=
MINT=
SELLER_TOKEN_ACCOUNT=
VERIFIER=

# Optional — protocol treasury for fee collection. If not set, fee handling
# will be limited (server can inform about fees but cannot validate treasury).
PROTOCOL_TREASURY=

# Optional — MVP defaults matching the architecture doc's Section 7.
TASK_PRICE=1500000
TASK_TIMEOUT_SECONDS=180
BIND_ADDR=0.0.0.0:3000
