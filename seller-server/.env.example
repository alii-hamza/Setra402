
# Setra402 seller gateway configuration

# RPC configuration
# These settings must be supported by the seller's RPC client.
RPC_HOST=127.0.0.1
RPC_PORT=8899

# Required account configuration
PROGRAM_ID=DHyQV6Khe42Papqad63dqkMHxqiKAUMcE4bugiHpZYtb
MINT=
SELLER_TOKEN_ACCOUNT=
VERIFIER=

# Treasury
PROTOCOL_TREASURY=

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Task defaults
TASK_PRICE=1500000
TASK_TIMEOUT_SECONDS=180
BIND_ADDR=0.0.0.0:3000

# Optional persistent blind-mint identity
# SETRA_MINT_SECRET_HEX=

# Optional server-owned provider configuration
# SETRA_PROVIDER_SECRET_FILE=
# SETRA_PROVIDER_CONNECTOR_FILE=
# SETRA_PROVIDER_REGISTRY_FILE=

# Test-only local/private-IP provider support
# SETRA_PROVIDER_TEST_MODE=false
