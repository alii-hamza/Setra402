MINT=So11111111111111111111111111111111111112
SELLER_TOKEN_ACCOUNT=So11111111111111111111111111111111111112
VERIFIER=So11111111111111111111111111111111111112
PROTOCOL_TREASURY=So11111111111111111111111111111111111112

# Redis for Phase 3
REDIS_URL=redis://redis:6379

# Task configuration
TASK_PRICE=1500000
TASK_TIMEOUT_SECONDS=180
BIND_ADDR=0.0.0.0:3000
